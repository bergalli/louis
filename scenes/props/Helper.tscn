[gd_scene load_steps=5 format=3]

[ext_resource type="Texture2D" path="res://assets/textures/props/enfant.png" id="1_texture"]

[sub_resource type="GDScript" id="GDScript_helper"]
script/source = "extends Area2D

@export var speed_bonus = 200.0
@export var message = \"Allez plus vite !\"

func _on_body_entered(body):
	if body.name == \"Player\":
		body.speed += speed_bonus
		print(message)
		# On pourrait ajouter un timer pour que le bonus disparaisse
		await get_tree().create_timer(3.0).timeout
		body.speed -= speed_bonus
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_helper"]
size = Vector2(60, 60)

[node name="Helper" type="Area2D"]
script = SubResource("GDScript_helper")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_helper")

[node name="Sprite2D" type="Sprite2D" parent="."]
scale = Vector2(0.07, 0.05)
texture = ExtResource("1_texture")

[node name="Label" type="Label" parent="."]
offset_left = -25.0
offset_top = -55.0
offset_right = 25.0
offset_bottom = -32.0
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
text = "HELP"
horizontal_alignment = 1

[connection signal="body_entered" from="." to="." method="_on_body_entered"]
